<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.organization.hr.pub_manager.TableManagerController">
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <TilePane fx:id="tableGrid" hgap="15" vgap="15">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                </TilePane>
            </content>
        </ScrollPane>
    </center>
    <right>
        <VBox prefWidth="250" spacing="10" style="-fx-background-color: #f0f0f0; -fx-border-color: #ccc; -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
            <Label text="Thông tin bàn">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label fx:id="tableNameLabel" text="Chưa chọn bàn" />
            <Label fx:id="tableStatusLabel" text="Trạng thái: " />
            <Label text="Tổng tiền:" />
            <Label fx:id="totalAmountLabel" style="-fx-font-weight: bold;" text="0đ" />
        </VBox>
    </right>
</BorderPane>