<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Pagination?>  <BorderPane fx:id="mainBorderPane" styleClass="parent" stylesheets="@css/Style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.organization.hr.pub_manager.MainController">

    <center>
        <BorderPane>
            <center>
                <Pagination fx:id="tablePagination" styleClass="table-pagination" />
            </center>
            <right>
<!--                <VBox prefWidth="250" spacing="10" style="-fx-background-color: #f0f0f0; -fx-border-color: #ccc; -fx-border-width: 0 0 0 1;">-->
<!--                    <padding>-->
<!--                        <Insets top="10" right="10" bottom="10" left="10" />-->
<!--                    </padding>-->
<!--                    <Label text="Thông tin bàn">-->
<!--                        <font>-->
<!--                            <Font name="System Bold" size="18.0" />-->
<!--                        </font>-->
<!--                    </Label>-->
<!--                    <Label fx:id="tableNameLabel" text="Chưa chọn bàn" />-->
<!--                    <Label fx:id="tableStatusLabel" text="Trạng thái: " />-->
<!--&lt;!&ndash;                    <Label text="Tổng tiền:" />&ndash;&gt;-->
<!--&lt;!&ndash;                    <Label fx:id="totalAmountLabel" style="-fx-font-weight: bold;" text="0đ" />&ndash;&gt;-->
<!--                </VBox>-->
            </right>
        </BorderPane>
    </center>

    <right>
        <VBox spacing="10" styleClass="cart-box">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-action-bar">
                <Button text="Phòng VIP 8 / P...">
                    <styleClass>
                        <String fx:value="btn-action"/>
                        <String fx:value="btn-round"/>
                        <String fx:value="btn-sophong"/>
                    </styleClass>
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                            <image>
                                <Image url="@icons/table.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <StackPane>
                    <TextField promptText="Tìm khách hàng (F4)">
                        <styleClass>
                            <String fx:value="btn-action"/>
                            <String fx:value="search-field"/>
                        </styleClass>
                    </TextField>
                    <Button text="+">
                        <styleClass>
                            <String fx:value="btn-add"/>
                            <String fx:value="btn-round"/>
                        </styleClass>
                        <StackPane.alignment>
                            <Pos fx:constant="CENTER_RIGHT"/>
                        </StackPane.alignment>
                    </Button>
                </StackPane>
                <ComboBox>
                    <styleClass>
                        <String fx:value="btn-action"/>
                        <String fx:value="combo-price"/>
                    </styleClass>
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Bảng giá chung"/>
                            <String fx:value="Bảng giá VIP"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Button>
                    <styleClass>
                        <String fx:value="btn-action"/>
                        <String fx:value="btn-cart"/>
                    </styleClass>
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@icons/cart.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" />

            <VBox spacing="5" styleClass="summary-box">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Tổng tiền món:" styleClass="summary-label" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="subTotalLabel" text="0đ" styleClass="summary-value"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Giảm giá (%/đ):" styleClass="summary-label" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtDiscount" text="0" promptText="Nhập % hoặc số tiền" prefWidth="100" styleClass="summary-input"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Phí dịch vụ (đ):" styleClass="summary-label" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtServiceFee" text="0" promptText="Nhập số tiền" prefWidth="100" styleClass="summary-input"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Thuế (VAT %/đ):" styleClass="summary-label" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtTax" text="0" promptText="Nhập % hoặc số tiền" prefWidth="100" styleClass="summary-input"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="grand-total-row">
                    <Label text="TỔNG THANH TOÁN:" styleClass="grand-total-label" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="grandTotalLabel" text="0đ" styleClass="grand-total-value"/>
                </HBox>
            </VBox>

            <VBox spacing="5" styleClass="cash-payment-box">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Tiền mặt nhận (đ):" styleClass="cash-label" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtCashReceived" promptText="Số tiền khách đưa" prefWidth="100" styleClass="cash-input"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="change-due-row">
                    <Label text="Tiền trả lại:" styleClass="change-due-label" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblChangeDue" text="0đ" styleClass="change-due-value"/>
                </HBox>
            </VBox>

            <VBox alignment="CENTER" spacing="5" styleClass="vnpay-box">
            </VBox>

            <HBox spacing="10">
                <Button onAction="#handleSaveOrder" text="Trong tạm tính" />
                <Button onAction="#handlePaymentAction" styleClass="btn-pay" text="Thanh toán Thẻ (F9)" />
                <Button onAction="#handleCashPayment" styleClass="btn-cash" text="TIỀN MẶT" />
            </HBox>

            <BorderPane.margin>
                <Insets left="7.0" />
            </BorderPane.margin>
        </VBox>
    </right>

</BorderPane>