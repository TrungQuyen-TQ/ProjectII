<!--                        </font>-->
<!--                    </Label>-->
<!--                    <Label fx:id="tableNameLabel" text="Chưa chọn bàn" />-->
<!--                    <Label fx:id="tableStatusLabel" text="Trạng thái: " />-->
<!--&lt;!&ndash;                    <Label text="Tổng tiền:" />&ndash;&gt;-->
<!--&lt;!&ndash;                    <Label fx:id="totalAmountLabel" style="-fx-font-weight: bold;" text="0đ" />&ndash;&gt;-->
<!--                </VBox>-->
<!--            </right>-->
        </BorderPane>
    </center>

    <right>
        <VBox spacing="10" styleClass="cart-box">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-action-bar">
                <StackPane />
            </HBox>

            <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" />

            <VBox spacing="5" styleClass="summary-box">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="summary-label" text="Tổng tiền món:" HBox.hgrow="ALWAYS" />
                    <Label fx:id="subTotalLabel" styleClass="summary-value" text="0đ" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="summary-label" text="Giảm giá (%/đ):" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtDiscount" prefWidth="100" promptText="Nhập % hoặc số tiền" styleClass="summary-input" text="0" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="summary-label" text="Phí dịch vụ (đ):" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtServiceFee" prefWidth="100" promptText="Nhập số tiền" styleClass="summary-input" text="0" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="summary-label" text="Thuế (VAT %/đ):" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtTax" prefWidth="100" promptText="Nhập % hoặc số tiền" styleClass="summary-input" text="0" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="grand-total-row">
                    <Label styleClass="grand-total-label" text="TỔNG THANH TOÁN:" HBox.hgrow="ALWAYS" />
                    <Label fx:id="grandTotalLabel" styleClass="grand-total-value" text="0đ" />
                </HBox>
            </VBox>

            <VBox spacing="5" styleClass="cash-payment-box">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="cash-label" text="Tiền mặt nhận (đ):" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtCashReceived" prefWidth="100" promptText="Số tiền khách đưa" styleClass="cash-input" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="change-due-row">
                    <Label styleClass="change-due-label" text="Tiền trả lại:" HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblChangeDue" styleClass="change-due-value" text="0đ" />
                </HBox>
            </VBox>

            <VBox alignment="CENTER" spacing="5" styleClass="vnpay-box">
            </VBox>

            <HBox spacing="10">
                <Button onAction="#handleSaveOrder" text="Trong tạm tính" />
                <Button onAction="#handlePaymentAction" styleClass="btn-pay" text="Thanh toán Thẻ (F9)" />
                <Button onAction="#handleCashPayment" styleClass="btn-cash" text="TIỀN MẶT" />
            </HBox>

            <BorderPane.margin>
                <Insets left="7.0" />
            </BorderPane.margin>
        </VBox>
    </right>

</BorderPane>
