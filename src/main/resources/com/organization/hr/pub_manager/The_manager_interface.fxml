<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="parent" stylesheets="@css/Style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.organization.hr.pub_manager.MainController">

    <!-- Thanh top -->
    <top>
        <AnchorPane prefHeight="700.0" prefWidth="1080.0" styleClass="topbar" BorderPane.alignment="CENTER">
            <children>
                <!-- Nút Bàn làm việc -->
                <Button layoutX="12.0" layoutY="14.0" mnemonicParsing="false" styleClass="btn_menu" text="Bàn làm việc" translateY="5.0">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                            <image>
                                <Image url="@icons/table.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </Button>

                <!-- Nút Thực đơn -->
                <Button layoutX="168.0" layoutY="14.0" mnemonicParsing="false" prefHeight="41.0" prefWidth="129.0" styleClass="btn_menu" text="Thực đơn" translateY="5.0">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                            <image>
                                <Image url="@icons/restaurant.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </Button>

                <!-- Ô tìm kiếm -->
                <ImageView fitHeight="16" fitWidth="16" layoutX="463.0" layoutY="28.0" preserveRatio="true" translateY="-3.0">
                    <image>
                        <Image url="@icons/magnifying-glass.png" />
                    </image>
                </ImageView>

                <TextField layoutX="484.0" layoutY="22.0" promptText="Tìm kiếm mục (F:)" translateY="-3.0" />

                <Button layoutX="689.0" layoutY="23.0" styleClass="btn_circle" translateY="-7.0">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20" preserveRatio="true" translateY="1.0">
                            <image>
                                <Image url="@icons/flash.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </children>
        </AnchorPane>
    </top>

    <!-- Bên trái: danh mục -->
    <left>
        <VBox spacing="5" styleClass="sidebar">
            <Button styleClass="btn_category" text="All" onAction="#handleCategorySelection" />

            <Button styleClass="btn_category" text="Đồ uống &amp; Thuốc lá" onAction="#handleCategorySelection" />

            <Button styleClass="btn_category" text="Món nước" onAction="#handleCategorySelection" />

            <Button styleClass="btn_category" text="Món cơm" onAction="#handleCategorySelection" />

            <Button styleClass="btn_category" text="Món ăn kèm" onAction="#handleCategorySelection" />

            <BorderPane.margin>
                <Insets right="7.0" />
            </BorderPane.margin>
        </VBox>
    </left>


    <!-- Trung tâm: danh sách món -->
    <center>
        <TilePane fx:id="menuGrid" hgap="15" prefColumns="4" styleClass="menu-grid" vgap="15">
        </TilePane>




    </center>

    <!-- Bên phải: giỏ hàng -->
    <right>
        <VBox prefHeight="740.0" prefWidth="671.0" spacing="10" styleClass="cart-box">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-action-bar">

                <!-- Nút chọn phòng -->
                <Button text="Phòng VIP 8 / P...">
                    <styleClass>
                        <String fx:value="btn-action" />
                        <String fx:value="btn-round" />
                        <String fx:value="btn-sophong" />
                    </styleClass>
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">
                            <image>
                                <Image url="@icons/table.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <!-- Ô tìm kiếm khách hàng -->

                <StackPane>
                    <TextField promptText="Tìm khách hàng (F4)">
                        <styleClass>
                            <String fx:value="btn-action" />
                            <String fx:value="search-field" />
                        </styleClass>
                    </TextField>

                    <Button text="+">
                        <styleClass>
                            <String fx:value="btn-add" />
                            <String fx:value="btn-round" />
                        </styleClass>
                        <StackPane.alignment>
                            <Pos fx:constant="CENTER_RIGHT" />
                        </StackPane.alignment>
                    </Button>
                </StackPane>





                <!-- ComboBox bảng giá -->
                <ComboBox>
                    <styleClass>
                        <String fx:value="btn-action" />
                        <String fx:value="combo-price" />
                    </styleClass>
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Bảng giá chung" />
                            <String fx:value="Bảng giá VIP" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <!-- Nút giỏ hàng -->
                <Button>
                    <styleClass>
                        <String fx:value="btn-action" />
                        <String fx:value="btn-cart" />
                    </styleClass>
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@icons/cart.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

            </HBox>


            <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" /> <!-- THAY ĐỔI: Thêm VBox.vgrow="ALWAYS" -->

            <!-- THAY ĐỔI MỚI: BẢNG TÓM TẮT TÍNH TIỀN -->
            <VBox spacing="5" styleClass="summary-box">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="summary-label" text="Tổng tiền món:" HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblSubTotal" styleClass="summary-value" text="0đ" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="summary-label" text="Giảm giá (%/đ):" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtDiscount" prefWidth="100" promptText="Nhập % hoặc số tiền" styleClass="summary-input" text="0" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="summary-label" text="Phí dịch vụ (đ):" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtServiceFee" prefWidth="100" promptText="Nhập số tiền" styleClass="summary-input" text="0" />
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="summary-label" text="Thuế (VAT %/đ):" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtTax" prefWidth="100" promptText="Nhập % hoặc số tiền" styleClass="summary-input" text="0" />
                </HBox>

                <!-- Dòng TỔNG CỘNG LỚN -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="grand-total-row">
                    <Label styleClass="grand-total-label" text="TỔNG THANH TOÁN:" HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblGrandTotal" styleClass="grand-total-value" text="0đ" />
                </HBox>
            </VBox>

            <!-- Nút Tạm tính/Thanh toán (di chuyển xuống dưới bảng tóm tắt) -->
            <HBox spacing="10">
                <Button onAction="#handleSaveOrder" text="Trong tạm tính" />
                <Button onAction="#handleCheckout" styleClass="btn-pay" text="Thanh toán (F9)" />
                <Button styleClass="btn-alert" text="Thông báo (F10)" />
            </HBox>
            <BorderPane.margin>
                <Insets left="7.0" />
            </BorderPane.margin>
        </VBox>
    </right>

</BorderPane>
