<BorderPane fx:id="mainBorderPane" styleClass="parent" stylesheets="@css/Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.organization.hr.pub_manager.MainController">

    <center>
        <BorderPane>
            <center>
                <Pagination fx:id="tablePagination" styleClass="table-pagination" />
            </center>
<!--            <right>-->
<!--                <VBox prefWidth="250" spacing="10" style="-fx-background-color: #f0f0f0; -fx-border-color: #ccc; -fx-border-width: 0 0 0 1;">-->
<!--                    <padding>-->
<!--                        <Insets top="10" right="10" bottom="10" left="10" />-->
<!--                    </padding>-->
<!--                    <Label text="Thông tin bàn">-->
<!--                        <font>-->
