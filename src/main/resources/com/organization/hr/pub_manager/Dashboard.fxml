<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" stylesheets="@css/Style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.organization.hr.pub_manager.DashboardController">
    <top>
        <Label text="Bảng Điều Khiển Của Quản Trị Viên" BorderPane.alignment="CENTER">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
        </Label>
    </top>
    <left>
        <VBox prefWidth="220.0" spacing="10" style="-fx-background-color: #f0f0f0; -fx-border-color: #ccc; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Button maxWidth="1.7976931348623157E308" onAction="#handleManageMeals" styleClass="btn_category" text="Quản Lý Món Ăn" />
                <Button maxWidth="1.7976931348623157E308" styleClass="btn_category" text="Quản Lý Nhân Viên" />
                <Button maxWidth="1.7976931348623157E308" styleClass="btn_category" text="Thống Kê Doanh Thu" />
                <Button fx:id="logoutButton" maxWidth="1.7976931348623157E308" onAction="#handleLogout" style="-fx-background-color: #ff6b6b;" text="Đăng Xuất" textFill="white" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" spacing="20" BorderPane.alignment="CENTER">
            <children>
                <Label text="Chào mừng Admin!">
                    <font>
                        <Font size="22.0" />
                    </font>
                </Label>
                <Label text="Chọn một chức năng từ menu bên trái để bắt đầu." />
            </children>
        </VBox>
    </center>
</BorderPane>